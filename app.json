{
  "expo": {
    "name": "Veyra",
    "slug": "AppRecordatorio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ralo.veyra",
      "associatedDomains": [
        "applinks:veyra.app"
      ]
    },
    "android": {
      "package": "com.ralo.veyra",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "VIBRATE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "veyra",
              "host": "*"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/ping_brillante.wav",
            "./assets/sounds/campana_electro.mp3",
            "./assets/sounds/clicks_tech.wav",
            "./assets/sounds/buzzer_fabrica.wav",
            "./assets/sounds/alarma_fuego.mp3",
            "./assets/sounds/bucle_alarma.wav",
            "./assets/sounds/alarma_incendio.mp3",
            "./assets/sounds/alarm_normal.wav",
            "./assets/sounds/alarm_strict.wav",
            "./assets/sounds/alarm_critical.wav"
          ]
        }
      ],
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-sharing",
      "expo-sqlite",
      "expo-status-bar",
      "expo-navigation-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-speech-recognition"
    ],
    "scheme": "veyra",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "01983506-e77d-4420-9219-4d451f832e9a"
      }
    }
  }
}